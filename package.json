{
	"name": "discord-radio-bots",
	"description": "Listen to radio channels inside Discord",
	"author": "DTrombett <d@trombett.org>",
	"homepage": "https://github.com/hydrabolt/discord-radio-bots#readme",
	"license": "Apache-2.0",
	"main": "dist/index.js",
	"type": "module",
	"private": true,
	"keywords": [
		"discord",
		"radio",
		"bot"
	],
	"bugs": {
		"url": "https://github.com/dtrombett/discord-radio-bots/issues"
	},
	"engines": {
		"node": ">=24"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dtrombett/discord-radio-bots.git"
	},
	"scripts": {
		"prepare": "node-gyp configure -- -f compile_commands_json",
		"build": "node esbuild.ts && node-gyp configure && node-gyp build && copy /Y \".\\deps\\ffmpeg\\bin\\*.dll\" \".\\dist\\\" && copy /Y \".\\build\\Release\\*.node\" \".\\dist\\\"",
		"start": "npm run build && node --inspect --enable-source-maps .",
		"test": "tsc"
	},
	"dependencies": {
		"@discordjs/rest": "^2.6.0",
		"@discordjs/voice": "^0.19.0",
		"@discordjs/ws": "^2.0.4",
		"@snazzah/davey": "^0.1.9",
		"bufferutil": "^4.1.0",
		"discord-api-types": "^0.38.37",
		"html-entities": "^2.6.0",
		"node": "^24.13.0",
		"undici": "^6.24.0"
	},
	"devDependencies": {
		"@tsconfig/node-lts": "^24.0.0",
		"@tsconfig/strictest": "^2.0.8",
		"@types/node": "^24.10.9",
		"esbuild": "^0.27.2",
		"node-gyp": "^12.1.0",
		"prettier": "^3.8.1",
		"typescript": "^5.9.3"
	}
}
